 BitAnnual::BitAnnual( int newBaseYear, int newLastYear ) :
-data((newLastYear - newBaseYear) / U_NUMBITS + 1),
+theData((newLastYear - newBaseYear) / U_NUMBITS + 1),
 baseYear(newBaseYear), lastYear(newLastYear)
